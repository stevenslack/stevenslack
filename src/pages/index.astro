---
import BaseHead from '../components/BaseHead.astro';
import DarkLight from '../components/DarkLight.astro';
import FooterHome from '../components/FooterHome.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import '../styles/main.scss';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="container">
			<DarkLight />
		</div>
		<main class="container">
			<section class="hero">
				<div class="heading-wrapper">
					<img src="/profile-sequoia.webp" alt="profile photo of Steven Slack" height="150" width="150" loading="lazy">
					<div class="heading">
						<h1 class="main-heading gradient-text">Steven Slack</h1>
						<h2>Senior Software Engineer</h2>
					</div>
				</div>
				<p>
					I'm a software engineer who leads technical strategy for web platforms, from global enterprise marketing sites to national news organizations.
				</p>
			</section>
			<hr>
		</main>
		<FooterHome />
	</body>
</html>
